PORT=5000

# Leave GEMINI_API_KEY empty to run in offline demo mode (rule-based replies)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Callers (the main MoTA app) must send this in the X-JAGO-API-KEY header.
# Leave empty to disable auth in local development ONLY.
JAGO_API_KEY=
# Comma-separated allowed origins, or * for any (dev only)
CORS_ORIGINS=*

RATE_LIMIT_PER_MIN=30
